# Trinetra production environment — copy to .env, fill in real values,
# and paste into Coolify's environment panel for this resource (Coolify
# reads its own env store, not this file directly, when the compose file
# is added as a "Docker Compose" resource — see
# docs/deploy/HETZNER_COOLIFY_DEPLOYMENT.md). Never commit the filled-in
# version of this file anywhere.

# --- Postgres ---
# Anything but the dev defaults (trinetra_app / trinetra_dev_pw) — those
# are placeholders for local development only, never valid here.
POSTGRES_USER=trinetra_prod
POSTGRES_PASSWORD=
POSTGRES_DB=trinetra_db

# --- Auth ---
# >=32 random characters. app/core/config.py refuses to start in
# production with a short secret or a known dev placeholder.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- CORS ---
# The real frontend origin(s), comma-separated, no trailing slash.
CORS_ORIGINS=https://your-domain.example

# --- Frontend build-time API URL ---
# Baked into the web image at BUILD time (Next.js inlines NEXT_PUBLIC_*),
# so this must be set before the web image is built, not just at runtime.
NEXT_PUBLIC_API_URL=https://your-domain.example/api

# --- AI Gateway (optional) ---
# Omit and the AI Gateway runs in fallback mode (ADR-0014) — a real deploy
# without this serves fake AI answers, a product decision, not a crash.
ANTHROPIC_API_KEY=

# --- Commerce (optional) ---
# Omit and order-creation returns PAYMENT_GATEWAY_NOT_CONFIGURED
# (ADR-0018) — no fake payments, ever.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
