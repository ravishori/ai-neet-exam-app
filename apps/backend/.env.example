# Trinetra backend — copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Database (async driver for the app, sync driver for Alembic)
DATABASE_URL=postgresql+asyncpg://trinetra_app:trinetra_dev_pw@localhost:5432/trinetra_db
DATABASE_URL_SYNC=postgresql+psycopg://trinetra_app:trinetra_dev_pw@localhost:5432/trinetra_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-every-real-environment
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# AI Gateway (ADR-0004 + FACTORY-P3.1 multi-provider)
# Never commit real keys. Enable providers explicitly.
AI_PROVIDER_DEFAULT=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_ENABLED=true
ANTHROPIC_MODEL=
AI_DEFAULT_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_ENABLED=false
# Default dev model; four-provider comparison pilot uses gpt-5-mini (see capabilities.py).
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_ENABLED=false
# Default dev model; four-provider comparison pilot uses gemini-2.5-flash.
GEMINI_MODEL=gemini-2.0-flash

MISTRAL_API_KEY=
MISTRAL_ENABLED=false
# Default dev model; four-provider comparison pilot uses mistral-small-2603.
MISTRAL_MODEL=mistral-small-latest

SARVAM_API_KEY=
SARVAM_ENABLED=false
SARVAM_MODEL=sarvam-105b

# MCQ-FACTORY-OPENROUTER-001 — OpenRouter (openrouter.ai), OpenAI-compatible.
# Never enabled by default. OPENROUTER_MODEL MUST be a real model id
# confirmed against OpenRouter's live /models listing
# (https://openrouter.ai/api/v1/models, no API key needed to list) before
# this provider can be used — leave it empty until that is confirmed; an
# empty value is treated as "not configured" and fails closed (see
# app/modules/ai/gateway/registry.py / app/modules/cms/services/mcq_llm_provider.py).
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# MCQ-FACTORY-KRUTRIM-001 — Krutrim (Ola Krutrim AI Cloud, cloud.olakrutrim.com),
# OpenAI-compatible. Never enabled by default. The real, confirmed API
# model id (from the official krutrim-cloud-python client's api.md /
# completions.py) is Krutrim-spectre-v2 — NOT "Krutrim-2", which is only
# the catalog/marketing display name. Krutrim's published rate is
# ₹6.6 per 1,000,000 tokens, for both input and output (Krutrim AI Studio
# billing docs). Leave KRUTRIM_MODEL empty until explicitly set; an empty
# value is treated as "not configured" and fails closed (see
# app/modules/ai/gateway/registry.py / app/modules/cms/services/mcq_llm_provider.py).
KRUTRIM_API_KEY=
KRUTRIM_ENABLED=false
KRUTRIM_BASE_URL=https://cloud.olakrutrim.com/v1
KRUTRIM_MODEL=

# MCQ-FACTORY-DEEPSEEK-001 — DeepSeek (api.deepseek.com), OpenAI-compatible.
# Never enabled by default. The real, confirmed, current model id is
# deepseek-flash (DeepSeek-V4.1-Flash under the hood; the legacy aliases
# deepseek-v4-flash/deepseek-chat are deprecated/being phased out).
# DeepSeek's published per-1,000,000-token rate is time-of-day dependent
# (peak 01:00-04:00 and 06:00-10:00 UTC Mon-Fri): input cache-miss $0.15
# off-peak / $0.30 peak; output $0.60 off-peak / $1.20 peak (cache-hit
# input is much cheaper but not assumed here). IMPORTANT: unlike
# GROQ_BASE_URL/OPENROUTER_BASE_URL/KRUTRIM_BASE_URL above,
# DEEPSEEK_BASE_URL deliberately has NO "/v1" suffix — DeepSeek's real,
# documented endpoint is https://api.deepseek.com/chat/completions. Do NOT
# "fix" this to match the other three providers; see
# app/modules/ai/gateway/deepseek_provider.py's module docstring. Leave
# DEEPSEEK_MODEL empty until explicitly set; an empty value is treated as
# "not configured" and fails closed (see
# app/modules/ai/gateway/registry.py / app/modules/cms/services/mcq_llm_provider.py).
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Content Factory routing — fixed | fixed_model | fallback_chain (never silent)
FACTORY_PROVIDER_MODE=fixed
FACTORY_PROVIDER=anthropic
FACTORY_PROVIDER_FALLBACK_CHAIN=

# Commerce (ADR-0006) — wired in Sprint 9
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public web URL (email links)
WEB_APP_URL=http://localhost:3000

# Optional SMTP (leave blank in local; Mailpit: host=localhost port=1025 tls=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Critical error / security alert destination (ops inbox)
ALERT_EMAIL=ravishori@gmail.com
# Optional alias if ALERT_EMAIL is unset
ERROR_REPORT_EMAIL=
# Set false to keep logging but skip outbound incident emails
ERROR_REPORTING_ENABLED=true

# Fernet key for encrypting TOTP secrets (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# CF-SOURCE-001 — canonical NCERT PDF root for NCERT-derived MCQ generation.
# Defaults to <repo>/NCERT Books locally. Override in CI with a fixture path.
# StudyMaterial/ is NOT an allowed NCERT generation source.
# NCERT_SOURCE_ROOT=

# Twilio Verify — mobile OTP login. Never commit real values.
# Verify Service SID is separate from Account SID/Auth Token — provision it in
# Twilio Console → Verify → Services and paste the VA… SID here.
# Unset → mobile OTP endpoints fail closed with TWILIO_VERIFY_NOT_CONFIGURED.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
