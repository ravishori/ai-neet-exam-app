# Trinetra backend — copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Database (async driver for the app, sync driver for Alembic)
DATABASE_URL=postgresql+asyncpg://trinetra_app:trinetra_dev_pw@localhost:5432/trinetra_db
DATABASE_URL_SYNC=postgresql+psycopg://trinetra_app:trinetra_dev_pw@localhost:5432/trinetra_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-every-real-environment
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# AI Gateway (ADR-0004) — Claude is the only wired provider in v1
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-6

# Commerce (ADR-0006) — wired in Sprint 9
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
